{
    "manifest_version": 3,
    "name": "D&D Beyond to Alchemy",
    "version": "1.0.0",
    "description": "Convert D&D Beyond characters for Alchemy RPG",
    "action": {
        "default_title": "Convert to Alchemy",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["activeTab", "scripting"]
}
