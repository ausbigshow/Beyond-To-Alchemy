{
  "name": "beyond-to-alchemy",
  "version": "1.0.0",
  "description": "Convert D&D Beyond characters (incl. homebrew and custom content) for Alchemy. Fork of alchemyrpg/ddb2alchemy.",
  "main": "src/index.ts",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "turndown": "^7.1.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "scripts": {
    "build": "esbuild src/site.ts --outfile=public/index.min.js --bundle --minify --sourcemap && yarn build:bookmarklet",
    "start": "yarn build && node server.js",
    "lint": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "build:bookmarklet": "esbuild src/bookmarklet.js --bundle --minify --format=iife --outfile=public/bookmarklet.min.js && sed -i '1s/^/javascript:/' public/bookmarklet.min.js",
    "build:extension": "mkdir -p dist-extension && esbuild src/extension-content.ts --outfile=dist-extension/content.js --bundle --minify --format=iife && cp extension/manifest.json extension/background.js dist-extension/ && cp public/favicon.png dist-extension/icon.png",
    "package:extension": "yarn build:extension && cd dist-extension && zip -r -X ../beyond-to-alchemy-extension-v$npm_package_version.zip ."
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-typescript": "^7.22.5",
    "@jest/globals": "^29.6.2",
    "@types/turndown": "^5.0.1",
    "esbuild": "^0.15.16",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "prettier": "^3.0.1",
    "typescript": "^4.9.3"
  }
}
